{
	"name": "svelte-kanban",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.4.2",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "oxfmt",
		"lint": "oxfmt --check && oxlint",
		"lint:fix": "oxlint --fix",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e && pnpm run test:integration",
		"test:e2e": "playwright test --project=e2e",
		"test:integration": "playwright test --config=playwright-integration.config.ts",
		"test:integration:headed": "playwright test --config=playwright-integration.config.ts --headed",
		"test:integration:ui": "playwright test --config=playwright-integration.config.ts --ui",
		"test:playwright": "playwright test"
	},
	"dependencies": {
		"@sveltejs/kit": "^3.0.1",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@vitest/browser": "^5.0.3",
		"@vitest/browser-playwright": "5.0.3",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.0",
		"jsdom": "^26.1.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"playwright": "^1.63.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3",
		"vitest-browser-svelte": "^3.1.0"
	}
}
